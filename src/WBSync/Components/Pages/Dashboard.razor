@page "/dashboard/{ProjectId:int}"
@inject IProjectRepository ProjectRepo
@inject ITaskRepository TaskRepo
@inject IAssigneeRepository AssigneeRepo
@inject IWorkLogRepository WorkLogRepo
@inject NavigationManager Nav

<div class="dashboard-page">
    <header class="dashboard-header">
        <div class="dashboard-header-left">
            <button class="back-btn" @onclick="GoBack">← 戻る</button>
            <span class="project-name">@_projectName - ダッシュボード</span>
        </div>
    </header>

    <div class="dashboard-table">
        <div class="dashboard-row dashboard-header-row">
            <div class="col col-assignee">担当者</div>
            <div class="col col-planned">予定工数</div>
            <div class="col col-actual">実績</div>
            <div class="col col-delay">遅れ</div>
        </div>

        @foreach (var summary in _summaries)
        {
            <div @key="summary.AssigneeId" class="dashboard-row">
                <div class="col col-assignee">
                    <button class="row-expand-btn" @onclick="() => ToggleExpand(summary)">
                        @(_expandedAssigneeIds.Contains(summary.AssigneeId) ? "▽" : "▷")
                    </button>
                    @summary.AssigneeName
                </div>
                <div class="col col-planned">@FormatWorkDays(summary.PlannedWorkDays)</div>
                <div class="col col-actual">@FormatWorkDays(summary.ActualPersonDays)</div>
                <div class="col col-delay @(summary.DelayWorkDays switch { > 0 => "value-positive", < 0 => "value-negative", _ => "" })">
                    @FormatDelay(summary.DelayWorkDays)
                </div>
            </div>

            @if (_expandedAssigneeIds.Contains(summary.AssigneeId) && _taskRowsByAssigneeId.TryGetValue(summary.AssigneeId, out var taskRows))
            {
                <div class="task-tree-panel">
                    @foreach (var row in taskRows)
                    {
                        <div @key="row.TaskId" class="task-tree-row">
                            <span class="task-tree-name" style="padding-left: @(row.Level * 20)px">
                                @row.Name
                                @if (!row.HasChildren && !row.IsOwned)
                                {
                                    <span class="not-owned-badge" title="現在の担当ではありません">実績のみ</span>
                                }
                            </span>
                            <span class="task-tree-planned">@FormatWorkDays(row.PlannedWorkDays)</span>
                            <span class="task-tree-actual">@FormatWorkDays(row.ActualPersonDays)</span>
                            <span class="task-tree-delay @(row.DelayWorkDays switch { > 0 => "value-positive", < 0 => "value-negative", _ => "" })">
                                @FormatDelay(row.DelayWorkDays)
                            </span>
                        </div>
                    }
                </div>
            }
        }

        @if (_summaries.Any())
        {
            <div class="dashboard-row dashboard-total-row">
                <div class="col col-assignee">合計</div>
                <div class="col col-planned">@FormatWorkDays(_total.PlannedWorkDays)</div>
                <div class="col col-actual">@FormatWorkDays(_total.ActualPersonDays)</div>
                <div class="col col-delay @(_total.DelayWorkDays switch { > 0 => "value-positive", < 0 => "value-negative", _ => "" })">
                    @FormatDelay(_total.DelayWorkDays)
                </div>
            </div>
        }
        else
        {
            <p class="empty-summaries">担当者が登録されていません</p>
        }
    </div>
</div>
