@page "/db-demo"
@inject NavigationManager Nav
@inject IProjectRepository ProjectRepo
@inject IAssigneeRepository AssigneeRepo
@inject ITaskRepository TaskRepo
@inject IGlobalHolidayRepository GlobalHolidayRepo
@inject IAssigneeHolidayRepository AssigneeHolidayRepo

<div class="demo">
    <div class="demo-header">
        <button class="back-btn" @onclick="GoBack">← 戻る</button>
        <h2>DB動作確認</h2>
    </div>

    <!-- ===== 1. Project ===== -->
    <section>
        <h3>1 — Project　GetAll / Create</h3>
        <div class="row">
            <input class="inp" placeholder="プロジェクト名" @bind="_pjName" />
            <DatePicker Value="_pjDate" ValueChanged="d => _pjDate = d" />
            <Button Variant="primary" OnClick="CreateProject">作成</Button>
        </div>
        @if (_pjStatus is { } pjStatus) { <p class="error">@pjStatus.Message</p> }
        <table class="tbl">
            <thead><tr><th>ID</th><th>名前</th><th>開始日</th><th>作成日時</th></tr></thead>
            <tbody>
                @foreach (var p in _projects)
                {
                    <tr><td>@p.Id</td><td>@p.Name</td><td>@p.StartDate</td><td>@p.CreatedAt</td></tr>
                }
                @if (!_projects.Any()) { <tr><td colspan="4" class="empty">データなし</td></tr> }
            </tbody>
        </table>
    </section>

    <!-- ===== 2. Assignee ===== -->
    <section>
        <h3>2 — Assignee　GetByProject / Create / Update / Delete / UpdateSortOrder</h3>
        <div class="row">
            <label>プロジェクト:</label>
            <select class="sel" @bind="_asgPjId" @bind:after="LoadAssignees">
                <option value="0">（選択）</option>
                @foreach (var p in _projects)
                {
                    <option value="@p.Id">[@p.Id] @p.Name</option>
                }
            </select>
        </div>
        @if (_asgPjId > 0)
        {
            <div class="row mt">
                <input class="inp" placeholder="担当者名" @bind="_asgName" />
                <Button Variant="primary" OnClick="CreateAssignee">追加</Button>
            </div>
            @if (_asgStatus is { } asgStatus) { <p class="error">@asgStatus.Message</p> }
            <table class="tbl">
                <thead><tr><th>ID</th><th>名前</th><th>Sort</th><th>更新日時</th><th>操作</th></tr></thead>
                <tbody>
                    @foreach (var a in _assignees)
                    {
                        <tr>
                            <td>@a.Id</td>
                            <td>
                                @if (_editAsgId == a.Id) { <input class="inp-sm" @bind="_editAsgName" /> }
                                else { @a.Name }
                            </td>
                            <td>@a.SortOrder</td>
                            <td>@a.UpdatedAt</td>
                            <td class="ops">
                                @if (_editAsgId == a.Id)
                                {
                                    <Button Variant="primary" OnClick="() => SaveAssignee(a)">保存</Button>
                                    <Button Variant="secondary" OnClick="CancelEditAssignee">取消</Button>
                                }
                                else
                                {
                                    <Button Variant="secondary" OnClick="() => StartEditAssignee(a)">編集</Button>
                                    <Button Variant="danger" OnClick="() => DeleteAssignee(a.Id)">削除</Button>
                                    <Button Variant="secondary" OnClick="() => MoveAssigneeUp(a)">↑</Button>
                                    <Button Variant="secondary" OnClick="() => MoveAssigneeDown(a)">↓</Button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!_assignees.Any()) { <tr><td colspan="5" class="empty">データなし</td></tr> }
                </tbody>
            </table>
        }
    </section>

    <!-- ===== 3. Task ===== -->
    <section>
        <h3>3 — Task　GetByProject / Create / Update / Delete / UpdateSortOrder</h3>
        <div class="row">
            <label>プロジェクト:</label>
            <select class="sel" @bind="_taskPjId" @bind:after="LoadTasks">
                <option value="0">（選択）</option>
                @foreach (var p in _projects)
                {
                    <option value="@p.Id">[@p.Id] @p.Name</option>
                }
            </select>
        </div>
        @if (_taskPjId > 0)
        {
            <div class="row mt">
                <input class="inp" placeholder="タスク名" @bind="_taskName" />
                <input class="inp-sm" type="number" min="0.5" step="0.5" placeholder="工数" @bind="_taskWorkDays" />
                <DatePicker Value="_taskStart" ValueChanged="d => _taskStart = d" />
                <DatePicker Value="_taskEnd" ValueChanged="d => _taskEnd = d" />
                <select class="sel" @bind="_taskStatus">
                    @foreach (var s in _statuses) { <option value="@s">@s</option> }
                </select>
                <Button Variant="primary" OnClick="CreateTask">追加</Button>
            </div>
            @if (_taskAddStatus is { } taskAddStatus) { <p class="error">@taskAddStatus.Message</p> }
            <table class="tbl">
                <thead>
                    <tr><th>ID</th><th>名前</th><th>工数</th><th>開始</th><th>終了</th><th>ステータス</th><th>進捗</th><th>Sort</th><th>操作</th></tr>
                </thead>
                <tbody>
                    @foreach (var t in _tasks)
                    {
                        <tr>
                            <td>@t.Id</td>
                            <td>
                                @if (_editTaskId == t.Id) { <input class="inp-sm" @bind="_editTaskName" /> }
                                else { @t.Name }
                            </td>
                            <td>@t.WorkDays</td>
                            <td>@t.StartDate</td>
                            <td>@t.EndDate</td>
                            <td>
                                @if (_editTaskId == t.Id)
                                {
                                    <select class="sel" @bind="_editTaskStatus">
                                        @foreach (var s in _statuses) { <option value="@s">@s</option> }
                                    </select>
                                }
                                else { @t.Status }
                            </td>
                            <td>
                                @if (_editTaskId == t.Id) { <input class="inp-sm" type="number" min="0" max="100" @bind="_editTaskProgress" /> }
                                else { @($"{t.Progress}%") }
                            </td>
                            <td>@t.SortOrder</td>
                            <td class="ops">
                                @if (_editTaskId == t.Id)
                                {
                                    <Button Variant="primary" OnClick="() => SaveTask(t)">保存</Button>
                                    <Button Variant="secondary" OnClick="CancelEditTask">取消</Button>
                                }
                                else
                                {
                                    <Button Variant="secondary" OnClick="() => StartEditTask(t)">編集</Button>
                                    <Button Variant="danger" OnClick="() => DeleteTask(t.Id)">削除</Button>
                                    <Button Variant="secondary" OnClick="() => MoveTaskUp(t)">↑</Button>
                                    <Button Variant="secondary" OnClick="() => MoveTaskDown(t)">↓</Button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!_tasks.Any()) { <tr><td colspan="9" class="empty">データなし</td></tr> }
                </tbody>
            </table>
        }
    </section>

    <!-- ===== 4. GlobalHoliday ===== -->
    <section>
        <h3>4 — GlobalHoliday　GetAll / Create / Delete　※重複日付でエラー確認可</h3>
        <div class="row">
            <DatePicker Value="_ghDate" ValueChanged="d => _ghDate = d" />
            <input class="inp" placeholder="休日名（例：元日）" @bind="_ghName" />
            <Button Variant="primary" OnClick="CreateGlobalHoliday">追加</Button>
        </div>
        @if (_ghStatus is { } ghStatus) { <p class="error">@ghStatus.Message</p> }
        <table class="tbl">
            <thead><tr><th>ID</th><th>日付</th><th>名称</th><th>操作</th></tr></thead>
            <tbody>
                @foreach (var h in _globalHolidays)
                {
                    <tr>
                        <td>@h.Id</td><td>@h.Date</td><td>@h.Name</td>
                        <td><Button Variant="danger" OnClick="() => DeleteGlobalHoliday(h.Id)">削除</Button></td>
                    </tr>
                }
                @if (!_globalHolidays.Any()) { <tr><td colspan="4" class="empty">データなし</td></tr> }
            </tbody>
        </table>
    </section>

    <!-- ===== 5. AssigneeHoliday ===== -->
    <section>
        <h3>5 — AssigneeHoliday　GetByAssignee / Create / Delete　※同一担当者の重複日付でエラー確認可</h3>
        <div class="row">
            <label>担当者:</label>
            <select class="sel" @bind="_ahAssigneeId" @bind:after="LoadAssigneeHolidays">
                <option value="0">（選択）</option>
                @foreach (var a in _allAssignees)
                {
                    <option value="@a.Id">[@a.Id] @a.Name (PJ:@a.ProjectId)</option>
                }
            </select>
        </div>
        @if (_ahAssigneeId > 0)
        {
            <div class="row mt">
                <DatePicker Value="_ahDate" ValueChanged="d => _ahDate = d" />
                <input class="inp" placeholder="メモ（例：有給休暇）" @bind="_ahMemo" />
                <Button Variant="primary" OnClick="CreateAssigneeHoliday">追加</Button>
            </div>
            @if (_ahStatus is { } ahStatus) { <p class="error">@ahStatus.Message</p> }
            <table class="tbl">
                <thead><tr><th>ID</th><th>日付</th><th>メモ</th><th>操作</th></tr></thead>
                <tbody>
                    @foreach (var h in _assigneeHolidays)
                    {
                        <tr>
                            <td>@h.Id</td><td>@h.Date</td><td>@h.Memo</td>
                            <td><Button Variant="danger" OnClick="() => DeleteAssigneeHoliday(h.Id)">削除</Button></td>
                        </tr>
                    }
                    @if (!_assigneeHolidays.Any()) { <tr><td colspan="4" class="empty">データなし</td></tr> }
                </tbody>
            </table>
        }
    </section>
</div>