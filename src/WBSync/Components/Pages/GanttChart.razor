@page "/gantt/{ProjectId:int}"
@inject IProjectRepository ProjectRepo
@inject ITaskRepository TaskRepo
@inject IAssigneeRepository AssigneeRepo
@inject IGlobalHolidayRepository GlobalHolidayRepo
@inject IAssigneeHolidayRepository AssigneeHolidayRepo
@inject IScheduleService ScheduleService
@inject NavigationManager Nav
@inject IJSRuntime JS

@{ var visibleNodes = TaskTreeHelper.GetVisibleNodes(_taskRoots).ToList(); }

<div class="gantt-page">
    <header class="gantt-header">
        <div class="gantt-header-left">
            <button class="back-btn" @onclick="GoBack">← 戻る</button>
            <span class="project-name">@_projectName</span>
        </div>
        <div class="gantt-header-right">
            <button class="scale-btn @(_showDependencyLines ? "scale-btn-active" : "")"
                    @onclick="ToggleDependencyLines">矢印</button>
            <Button Variant="secondary" OnClick="GoToAssignees">担当者設定</Button>
            <Button Variant="secondary" OnClick="GoToEffort">工数管理</Button>
            <div class="scale-switcher">
                <button class="scale-btn @(_scale == ChartScale.Day ? "scale-btn-active" : "")"
                        @onclick='() => SetScale(ChartScale.Day)'>日</button>
                <button class="scale-btn @(_scale == ChartScale.Week ? "scale-btn-active" : "")"
                        @onclick='() => SetScale(ChartScale.Week)'>週</button>
                <button class="scale-btn @(_scale == ChartScale.Month ? "scale-btn-active" : "")"
                        @onclick='() => SetScale(ChartScale.Month)'>月</button>
            </div>
        </div>
    </header>

    @if (_pageStatus is { } pageStatus)
    {
        <div class="page-error-banner">
            <span>@pageStatus.Message</span>
            <button class="page-error-close" @onclick="() => _pageStatus = null">×</button>
        </div>
    }

    <div class="gantt-body">
        <div id="task-pane" class="task-pane">
            <div class="task-pane-scroll">
                <div class="task-pane-header">
                    <div class="col col-name">
                        タスク名
                        <div class="col-name-resize-handle" id="col-name-resize"></div>
                    </div>
                    <div class="col col-assignee">担当者</div>
                    <div class="col col-workdays">工数</div>
                    <div class="col col-start">開始日</div>
                    <div class="col col-end">終了日</div>
                    <div class="col col-status">ステータス</div>
                    <div class="col col-progress">進捗</div>
                </div>
                <div class="task-pane-rows" id="task-pane-rows">
                    @for (var i = 0; i < visibleNodes.Count; i++)
                    {
                        var node = visibleNodes[i];
                        var idx = i;
                        <div @key="node.Task.Id"
                             class="task-row @(_hoveredRowIndex == idx ? "row-hovered" : "")"
                             data-task-id="@node.Task.Id"
                             data-parent-id="@(node.Task.ParentId?.ToString() ?? "")"
                             @onmouseenter="() => SetHoveredRow(idx)"
                             @onmouseleave="() => SetHoveredRow(-1)"
                             @ondblclick="() => OnTaskRowClick(node)"
                             @oncontextmenu:preventDefault="true"
                             @oncontextmenu="e => ShowContextMenu(e, node)">
                            <div class="col col-name">
                                <div class="name-indent" style="padding-left: @(8 + node.Level * 20)px">
                                    @if (node.HasChildren)
                                    {
                                        <button class="expand-btn"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => ToggleExpand(node)">
                                            @(node.IsExpanded ? "▼" : "▶")
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="expand-spacer"></span>
                                    }
                                    <span class="task-name-text">@node.Task.Name</span>
                                    @if (!node.HasChildren && _warningTaskIds.Contains(node.Task.Id))
                                    {
                                        <span class="warn-icon" title="同一担当者の別タスクと稼働日が重複しています">⚠</span>
                                    }
                                    @if (node.HasWorkDaysOverflow)
                                    {
                                        <span class="warn-icon" title="@GetWorkDaysOverflowTooltip(node)">⚠</span>
                                    }
                                </div>
                            </div>
                            <div class="col col-assignee">
                                @(node.HasChildren ? "-" : GetAssigneeName(node.Task.AssigneeId))
                            </div>
                            <div class="col col-workdays">
                                @(node.HasChildren ? "-" : node.Task.WorkDays?.ToString("0.##") ?? "-")
                            </div>
                            <div class="col col-start">@FormatDate(node.DisplayStartDate)</div>
                            <div class="col col-end">@FormatDate(node.DisplayEndDate)</div>
                            <div class="col col-status">
                                @if (!node.HasChildren)
                                {
                                    <Badge Status="@node.Task.Status" />
                                }
                            </div>
                            <div class="col col-progress">
                                @(node.HasChildren ? "" : $"{node.Task.Progress}%")
                            </div>
                        </div>
                    }
                    @if (!_taskRoots.Any())
                    {
                        <p class="empty-tasks">タスクが登録されていません</p>
                    }
                </div>
            </div>
            <div class="task-pane-footer">
                <button class="add-task-btn" @onclick="AddTask">＋ タスクを追加</button>
            </div>
        </div>

        <div id="gantt-splitter" class="pane-splitter"></div>

        <div class="chart-pane" id="chart-pane">
            @if (_chartColumns.Count > 0)
            {
                <div class="chart-inner scale-@(_scale.ToString().ToLower())">
                    <div class="chart-time-header">
                        @foreach (var col in _chartColumns)
                        {
                            <div class="chart-col-header @GetHeaderCellClass(col)">@col.Label</div>
                        }
                    </div>
                    <div class="chart-rows-area" id="chart-rows-area">
                        @for (var i = 0; i < visibleNodes.Count; i++)
                        {
                            var node = visibleNodes[i];
                            var idx = i;
                            var barStyle = GetBarStyle(node);
                            <div @key="node.Task.Id"
                                 class="chart-task-row @(_hoveredRowIndex == idx ? "row-hovered" : "")"
                                 @onmouseenter="() => SetHoveredRow(idx)"
                                 @onmouseleave="() => SetHoveredRow(-1)">
                                @foreach (var col in _chartColumns)
                                {
                                    <div class="chart-col-cell @GetCellClass(node, col)"></div>
                                }
                                @if (barStyle is not null)
                                {
                                    @if (node.HasChildren)
                                    {
                                        <div id="task-bar-@node.Task.Id" class="task-bar task-bar-parent" style="@barStyle"></div>
                                    }
                                    else
                                    {
                                        <div id="task-bar-@node.Task.Id" class="task-bar task-bar-leaf" style="@barStyle">
                                            <div class="task-bar-progress" style="width:@(node.Task.Progress)%"></div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (_ctxVisible)
{
    <div class="ctx-overlay" @onclick="CloseContextMenu"></div>
    <div class="ctx-menu" style="left:@(_ctxX)px;top:@(_ctxY)px;">
        <button class="ctx-item" @onclick="AddChildTask">子タスクを追加</button>
        <button class="ctx-item" @onclick="AddSiblingTask">同階層にタスクを追加</button>
        <div class="ctx-separator"></div>
        <button class="ctx-item ctx-item-danger" @onclick="ShowCtxDeleteConfirm">タスクを削除</button>
    </div>
}

<ConfirmDialog IsOpen="_showCtxDeleteConfirm"
               Title="タスクを削除しますか？"
               Message="@_ctxDeleteMessage"
               ConfirmText="削除"
               CancelText="キャンセル"
               OnConfirm="HandleCtxDeleteConfirm"
               OnCancel="() => _showCtxDeleteConfirm = false" />

<TaskEditModal IsOpen="_isTaskModalOpen"
               Task="_taskModalTask"
               ProjectId="ProjectId"
               ParentId="_taskModalParentId"
               Assignees="_allAssignees"
               AllTasks="_allTasksWbsOrdered"
               OnClose="HandleTaskModalClose"
               OnSaved="HandleTaskSaved"
               OnDeleted="HandleTaskDeleted" />