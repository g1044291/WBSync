@page "/"
@inject IProjectRepository ProjectRepo
@inject IGlobalAssigneeRepository GlobalAssigneeRepo
@inject IGlobalHolidayRepository HolidayRepo
@inject NavigationManager Nav

<ProjectCreateModal IsOpen="_createModalOpen"
                    ProjectRepo="ProjectRepo"
                    OnClose="CloseCreateModal"
                    OnCreated="HandleProjectCreated" />

<HolidaySettingsModal IsOpen="_holidayModalOpen"
                      HolidayRepo="HolidayRepo"
                      OnClose="CloseHolidayModal" />

<GlobalAssigneeSettingsModal IsOpen="_assigneeModalOpen"
                             GlobalAssigneeRepo="GlobalAssigneeRepo"
                             OnClose="CloseAssigneeModal" />

<div class="page-project-list">
    <header class="page-header">
        <span class="app-title">WBSync</span>
        <div class="header-actions">
            <button class="hamburger-btn" @onclick="ToggleMenu" aria-label="メニュー" aria-expanded="@(_menuOpen ? "true" : "false")">☰</button>
        </div>
    </header>

    @if (_menuOpen)
    {
        <div class="menu-overlay" @onclick="CloseMenu"></div>
        <div class="menu-panel">
            <button class="menu-item" @onclick="HandleMenuCrossProjectView">横断ビュー</button>
            <button class="menu-item" @onclick="HandleMenuHoliday">休日設定</button>
            <button class="menu-item" @onclick="HandleMenuAssignee">担当者設定</button>
        </div>
    }

    <main class="page-main">
        @if (_projects.Count == 0)
        {
            <p class="empty-message">プロジェクトが登録されていません。「新規登録」からプロジェクトを作成してください。</p>
        }
        else
        {
            <div class="project-list">
                @foreach (var p in _projects)
                {
                    <button class="project-row" @onclick="() => GoToGantt(p.Id)">
                        @p.Name
                    </button>
                }
            </div>
        }
    </main>

    <footer class="page-footer">
        <Button Variant="primary" OnClick="OpenCreateModal">新規登録</Button>
        @if (_isDebug)
        {
            <Button Variant="secondary" OnClick="GoToDev">開発メニュー</Button>
        }
    </footer>
</div>
