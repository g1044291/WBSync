@page "/assignees/{ProjectId:int}/{AssigneeId:int}"
@inject IAssigneeRepository AssigneeRepo
@inject IGlobalAssigneeRepository GlobalAssigneeRepo
@inject IAssigneeHolidayRepository HolidayRepo
@inject NavigationManager Nav

<Modal IsOpen="_addHolidayOpen" Title="個人休日を追加" OnClose="CloseAddHoliday">
    <ChildContent>
        <div class="form-group">
            <label class="form-label">日付 <span class="required">*</span></label>
            <DatePicker Value="_newHolidayDate" ValueChanged="d => _newHolidayDate = d" />
        </div>
        <div class="form-group">
            <label class="form-label">メモ</label>
            <input class="form-input" type="text" placeholder="例：有給休暇" @bind="_newHolidayMemo" />
        </div>
        @if (_holidayError is not null)
        {
            <p class="form-error">@_holidayError</p>
        }
    </ChildContent>
    <Footer>
        <Button Variant="secondary" OnClick="CloseAddHoliday">キャンセル</Button>
        <Button Variant="primary" OnClick="AddHoliday" Disabled="_saving">保存</Button>
    </Footer>
</Modal>

<ConfirmDialog IsOpen="_unlinkConfirmOpen"
               Message="グローバルマスタとの連携を解除し、プロジェクト専用担当者にします。よろしいですか？"
               OnConfirm="UnlinkGlobal"
               OnCancel="CloseUnlinkConfirm" />

<div class="assignee-detail-page">
    <header class="page-header">
        <button class="back-btn" @onclick="GoBack">← 戻る</button>
        <span class="page-title">担当者詳細</span>
    </header>

    @if (_assignee is not null)
    {
        <main class="page-main">
            @if (_linkedGlobal is not null)
            {
                <section class="global-link-section">
                    <span class="global-link-name">@_linkedGlobal.Name</span>
                    <Button Variant="secondary" OnClick="OpenUnlinkConfirm">連携解除</Button>
                </section>
            }

            <section class="name-section">
                <label class="field-label">担当者名</label>
                @if (_linkedGlobal is not null)
                {
                    <div class="name-row">
                        <input class="name-input" type="text" value="@_editName" readonly />
                    </div>
                }
                else
                {
                    <div class="name-row">
                        <input class="name-input" type="text" @bind="_editName" />
                        <Button Variant="primary" OnClick="SaveName" Disabled="_nameSaving">保存</Button>
                    </div>
                    @if (_nameError is not null)
                    {
                        <p class="form-error">@_nameError</p>
                    }
                    @if (_nameSaved)
                    {
                        <p class="save-success">保存しました</p>
                    }
                }
            </section>

            <section class="coefficient-section">
                <label class="field-label">生産性係数</label>
                <div class="name-row">
                    <input class="name-input" type="number" step="0.01" min="0.01" @bind="_editCoefficient" />
                    <Button Variant="primary" OnClick="SaveCoefficient" Disabled="_coefficientSaving">保存</Button>
                </div>
                @if (_coefficientError is not null)
                {
                    <p class="form-error">@_coefficientError</p>
                }
                @if (_coefficientSaved)
                {
                    <p class="save-success">保存しました</p>
                }
            </section>

            <section class="holiday-section">
                <div class="section-header">
                    <span class="section-title">個人休日</span>
                    <Button Variant="primary" OnClick="OpenAddHoliday">＋ 追加</Button>
                </div>
                <div class="holiday-list">
                    @foreach (var h in _holidays)
                    {
                        <div class="holiday-row">
                            <span class="holiday-date">@FormatDate(h.Date)</span>
                            <span class="holiday-memo">@h.Memo</span>
                            <Button Variant="danger" OnClick="() => DeleteHoliday(h.Id)">削除</Button>
                        </div>
                    }
                    @if (!_holidays.Any())
                    {
                        <p class="empty-message">個人休日が登録されていません</p>
                    }
                </div>
            </section>
        </main>
    }
</div>
