<Modal IsOpen="IsOpen" Title="プロジェクトを作成" OnClose="HandleClose">
    <ChildContent>
        <div class="form-group">
            <label class="form-label">プロジェクト名 <span class="required">*</span></label>
            <input class="form-input" type="text" placeholder="プロジェクト名を入力"
                   @bind="_name" @bind:event="oninput" />
        </div>
        <div class="form-group">
            <label class="form-label">開始日 <span class="required">*</span></label>
            <DatePicker Value="_startDate" ValueChanged="d => _startDate = d" />
        </div>
        @if (_formStatus is { } formStatus)
        {
            <p class="form-error">@formStatus.Message</p>
        }
    </ChildContent>
    <Footer>
        <Button Variant="secondary" OnClick="HandleClose">キャンセル</Button>
        <Button Variant="primary" OnClick="HandleSubmit" Disabled="_disableCreate">作成</Button>
    </Footer>
</Modal>