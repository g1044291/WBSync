@inject ITaskRepository TaskRepo
@inject IScheduleService ScheduleService

<Modal IsOpen="IsOpen" Title="@_title" OnClose="HandleClose">
    <ChildContent>
        <div class="form-group">
            <label class="form-label">タスク名 <span class="required">*</span></label>
            <input class="form-input" type="text" placeholder="タスク名を入力"
                   value="@_name"
                   @onchange="e => { _name = e.Value?.ToString() ?? string.Empty; _isDirty = true; }" />
        </div>

        <div class="form-group">
            <label class="form-label">親タスク</label>
            <Dropdown TValue="WbsTask" Items="_parentCandidates" DisplayText="GetDisplayName"
                      Value="_parent" ValueChanged="t => { _parent = t; _isDirty = true; }"
                      AllowEmpty="true" EmptyLabel="（ルート）" />
        </div>

        <div class="form-group">
            <label class="form-label">担当者</label>
            <Dropdown TValue="Assignee" Items="Assignees" DisplayText="a => a.Name"
                      Value="_assignee" ValueChanged="a => { _assignee = a; _isDirty = true; }"
                      AllowEmpty="true" EmptyLabel="（なし）" />
        </div>

        <div class="form-row">
            <div class="form-group form-group-half">
                <label class="form-label">工数</label>
                <div class="input-with-unit">
                    <input class="form-input" type="number" min="0" step="0.5" placeholder="0"
                           value="@_workDaysStr"
                           @onchange="HandleWorkDaysChanged" />
                    <span class="input-unit">人日</span>
                </div>
            </div>
            <div class="form-group form-group-half">
                <label class="form-label">進捗率</label>
                <div class="input-with-unit">
                    <input class="form-input" type="number" min="0" max="100" step="1" placeholder="0"
                           value="@_progress"
                           @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var p)) _progress = p; _isDirty = true; }" />
                    <span class="input-unit">%</span>
                </div>
            </div>
        </div>

        @if (_isParent)
        {
            <div class="form-group">
                <p class="parent-date-note">開始日・終了日は子タスクの日付から自動計算されます</p>
            </div>
        }
        else
        {
            <div class="form-row">
                <div class="form-group form-group-half">
                    <label class="form-label">開始日 <span class="required">*</span></label>
                    <DatePicker Value="_startDate" ValueChanged="HandleStartDateChanged" />
                </div>
                <div class="form-group form-group-half">
                    <label class="form-label">終了日</label>
                    <DatePicker Value="_endDate" ValueChanged="d => { _endDate = d; _isDirty = true; }" />
                </div>
            </div>
        }

        <div class="form-group">
            <label class="form-label">先行タスク</label>
            <Dropdown TValue="WbsTask" Items="_predecessorCandidates" DisplayText="GetDisplayName"
                      Value="_predecessor" ValueChanged="HandlePredecessorChanged"
                      AllowEmpty="true" EmptyLabel="（なし）" />
        </div>

        <div class="form-group">
            <label class="form-label">ステータス</label>
            <select class="form-input"
                    value="@_status"
                    @onchange="OnStatusChange">
                <option value="未着手">未着手</option>
                <option value="進行中">進行中</option>
                <option value="完了">完了</option>
                <option value="保留">保留</option>
            </select>
        </div>

        <div class="form-group">
            <label class="form-label">備考</label>
            <textarea class="form-input form-textarea" placeholder="備考を入力"
                      value="@_notes"
                      @onchange="e => { _notes = e.Value?.ToString() ?? string.Empty; _isDirty = true; }"></textarea>
        </div>

        @if (_error is not null)
        {
            <p class="form-error">@_error</p>
        }
    </ChildContent>
    <Footer>
        @if (Task is not null)
        {
            <div class="footer-left">
                <Button Variant="danger" OnClick="HandleDeleteClick">削除</Button>
            </div>
        }
        <Button Variant="secondary" OnClick="HandleClose">キャンセル</Button>
        <Button Variant="primary" OnClick="HandleSave" Disabled="_saving">保存</Button>
    </Footer>
</Modal>

<ConfirmDialog IsOpen="_showUnsavedDialog"
               Title="変更を破棄しますか？"
               Message="保存されていない変更があります。破棄してよろしいですか？"
               ConfirmText="破棄"
               CancelText="編集を続ける"
               ConfirmVariant="secondary"
               OnConfirm="HandleUnsavedConfirm"
               OnCancel="() => _showUnsavedDialog = false" />

<ConfirmDialog IsOpen="_showDeleteDialog"
               Title="タスクを削除しますか？"
               Message="@_deleteMessage"
               ConfirmText="削除"
               CancelText="キャンセル"
               OnConfirm="HandleDeleteConfirm"
               OnCancel="() => _showDeleteDialog = false" />