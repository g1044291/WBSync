<Modal IsOpen="IsOpen" Title="休日設定" OnClose="HandleClose">
    <ChildContent>
        <p class="fixed-note">※ 土曜・日曜は固定休日です</p>

        <div class="section-header">
            <span class="section-title">祝日・特別休日</span>
            @if (!_isAdding)
            {
                <div class="header-actions">
                    <Button Variant="secondary" OnClick="ImportCsv" Disabled="_importing">CSVインポート</Button>
                    <Button Variant="primary" OnClick="StartAdding">＋ 追加</Button>
                </div>
            }
        </div>

        @if (_importMessage is not null)
        {
            <p class="@(_importIsError ? "error-message" : "import-message")">@_importMessage</p>
        }

        @if (_isAdding)
        {
            <div class="add-form">
                <div class="add-form-fields">
                    <DatePicker Value="_newDate" ValueChanged="d => _newDate = d" />
                    <input class="name-input" type="text" placeholder="休日名（例：元日）" @bind="_newName" />
                </div>
                <div class="add-form-actions">
                    <Button Variant="secondary" OnClick="CancelAdding">取消</Button>
                    <Button Variant="primary" OnClick="AddHoliday" Disabled="_saving">保存</Button>
                </div>
            </div>
            @if (_error is not null)
            {
                <p class="error-message">@_error</p>
            }
        }

        <div class="holiday-list">
            @foreach (var h in _holidays)
            {
                <div class="holiday-row">
                    <span class="holiday-date">@FormatDate(h.Date)</span>
                    <span class="holiday-name">@h.Name</span>
                    <Button Variant="danger" OnClick="() => DeleteHoliday(h.Id)">削除</Button>
                </div>
            }
            @if (!_holidays.Any())
            {
                <p class="empty-message">登録された休日はありません</p>
            }
        </div>
    </ChildContent>
</Modal>